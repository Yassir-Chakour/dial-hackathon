APP_ENV=development
APP_NAME=wolf-materials-backend
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:8084
API_HOST=127.0.0.1
API_PORT=8000
ALLOW_EXTERNAL_BIND=false
DATABASE_URL=postgresql+psycopg://wolf:change-me@127.0.0.1:5432/wolf_materials
SOURCE_STORAGE_MODE=database
SOURCE_MAX_BYTES=25000000
OBJECT_STORAGE_DIR=./data/objects
WORKER_MAX_ATTEMPTS=3
